# Copy to .env for local/interactive sessions. Never commit .env.
# In GitHub Actions these are repo secrets instead, not this file.

ANTHROPIC_API_KEY=
CONTACT_EMAIL=
TAGGER_MODEL=claude-haiku-4-5

# Google Alerts feed URLs. Kept out of the repo because the URL embeds the
# Google account id that owns the alert (this repo is public) and can't be
# rotated without recreating the alert. Each topic profile's `alerts:`
# entries name the variable to read via `feed_url_env`.
CBDC_ALERT_FEED_URL=

# Optional, raises OpenAlex/Semantic Scholar rate limits:
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
GOOGLE_BOOKS_API_KEY=
